FROM rust:1.90.0-slim-bookworm@sha256:64232e656c058f4468e8d024e990acff04f0fd5a5c0a88a574dc37773d7325c9 AS rust
FROM sol-pi-eval-polyglot-login:2026-10-04
USER root
COPY --from=rust /usr/local/rustup /usr/local/rustup
COPY --from=rust /usr/local/cargo /usr/local/cargo
ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo PATH="/usr/local/cargo/bin:${PATH}"
RUN apt-get update && apt-get install -y --no-install-recommends cmake openjdk-17-jdk-headless && rm -rf /var/lib/apt/lists/*
RUN for tool in cargo rustc rustdoc rustfmt rustup cargo-clippy cargo-fmt clippy-driver; do ln -s /usr/local/cargo/bin/$tool /usr/local/bin/$tool; done
USER evaluator
WORKDIR /workspace
