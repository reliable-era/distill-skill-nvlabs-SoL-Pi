@@ -1,4 +1,5 @@
 import json
+import pytest
 from tasks_cli.cli import main
 
 
@@ -6,3 +7,41 @@ def test_json(capsys):
     main(["--json"])
     out = json.loads(capsys.readouterr().out)
     assert list(out) == ["items"] and len(out["items"]) == 4
+
+
+def test_limit(capsys):
+    main(["--limit", "2"])
+    out = capsys.readouterr().out
+    assert out == "2 write report\n1 backup db\n"
+
+
+def test_sort_name(capsys):
+    main(["--sort", "name"])
+    out = capsys.readouterr().out
+    assert [line.split(" ", 1)[1] for line in out.splitlines()] == [
+        "archive logs", "backup db", "call vendor", "write report",
+    ]
+
+
+def test_sort_priority_ties_by_name(capsys):
+    main(["--sort", "priority"])
+    out = capsys.readouterr().out
+    assert out == "1 backup db\n2 archive logs\n2 write report\n3 call vendor\n"
+
+
+def test_limit_applies_after_sort(capsys):
+    main(["--sort", "priority", "--limit", "2"])
+    out = capsys.readouterr().out
+    assert out == "1 backup db\n2 archive logs\n"
+
+
+def test_json_with_limit_and_sort(capsys):
+    main(["--json", "--sort", "name", "--limit", "1"])
+    out = json.loads(capsys.readouterr().out)
+    assert out == {"items": [{"name": "archive logs", "priority": 2}]}
+
+
+@pytest.mark.parametrize("bad", ["0", "-1", "abc"])
+def test_limit_rejects_non_positive(bad):
+    with pytest.raises(SystemExit):
+        main(["--limit", bad])
