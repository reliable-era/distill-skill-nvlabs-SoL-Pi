+def positive_int(s):
+    try:
+        value = int(s)
+    except ValueError:
+        raise argparse.ArgumentTypeError(f"expected an integer, got {s!r}")
+    if value <= 0:
+        raise argparse.ArgumentTypeError("expected a positive integer")
+    return value
+
+
 def main(argv=None):
     p = argparse.ArgumentParser(prog="tasks")
     p.add_argument("--json", action="store_true", help="print as JSON")
+    p.add_argument("--limit", type=positive_int, help="print only the first N items")
+    p.add_argument("--sort", choices=["name", "priority"], help="sort items")
     args = p.parse_args(argv)
     items = list(ITEMS)
+    if args.sort == "name":
+        items.sort(key=lambda it: it["name"])
+    elif args.sort == "priority":
+        items.sort(key=lambda it: (it["priority"], it["name"]))
+    if args.limit is not None:
+        items = items[: args.limit]
     if args.json:
         print(json.dumps({"items": items}))
     else:
