+++ b/tests/test_cli.py
@@ -1,4 +1,6 @@
 import json
+import pytest
+
 from tasks_cli.cli import main
 
 
@@ -6,3 +8,46 @@ def test_json(capsys):
     main(["--json"])
     out = json.loads(capsys.readouterr().out)
     assert list(out) == ["items"] and len(out["items"]) == 4
+
+
+def _names(capsys):
+    return [line.split(" ", 1)[1] for line in capsys.readouterr().out.splitlines()]
+
+
+def test_limit_keeps_first_n_in_default_order(capsys):
+    main(["--limit", "2"])
+    assert _names(capsys) == ["write report", "backup db"]
+
+
+def test_limit_larger_than_item_count(capsys):
+    main(["--limit", "10"])
+    assert len(_names(capsys)) == 4
+
+
+@pytest.mark.parametrize("value", ["0", "-3", "abc"])
+def test_limit_rejects_non_positive_or_invalid(capsys, value):
+    with pytest.raises(SystemExit) as exc:
+        main(["--limit", value])
+    assert exc.value.code == 2
+
+
+def test_sort_name_alphabetical(capsys):
+    main(["--sort", "name"])
+    assert _names(capsys) == ["archive logs", "backup db", "call vendor", "write report"]
+
+
+def test_sort_priority_ascending_ties_by_name(capsys):
+    main(["--sort", "priority"])
+    assert _names(capsys) == ["backup db", "archive logs", "write report", "call vendor"]
+
+
+def test_sort_applied_before_limit(capsys):
+    main(["--sort", "priority", "--limit", "3"])
+    assert _names(capsys) == ["backup db", "archive logs", "write report"]
+
+
+def test_json_with_sort_and_limit(capsys):
+    main(["--json", "--sort", "name", "--limit", "2"])
+    out = json.loads(capsys.readouterr().out)
+    assert list(out) == ["items"]
+    assert [it["name"] for it in out["items"]] == ["archive logs", "backup db"]
