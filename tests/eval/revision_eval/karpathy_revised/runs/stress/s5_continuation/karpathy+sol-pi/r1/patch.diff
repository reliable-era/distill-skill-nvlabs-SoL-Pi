+def positive_int(value):
+    try:
+        n = int(value)
+    except ValueError:
+        raise argparse.ArgumentTypeError(f"invalid int value: {value!r}")
+    if n <= 0:
+        raise argparse.ArgumentTypeError(f"{value!r} is not a positive integer")
+    return n
+
+
 def main(argv=None):
     p = argparse.ArgumentParser(prog="tasks")
     p.add_argument("--json", action="store_true", help="print as JSON")
+    p.add_argument("--limit", type=positive_int, metavar="N",
+                   help="print only the first N items")
+    p.add_argument("--sort", choices=["name", "priority"],
+                   help="sort items by name or priority")
     args = p.parse_args(argv)
     items = list(ITEMS)
+    if args.sort == "name":
+        items.sort(key=lambda it: it["name"])
+    elif args.sort == "priority":
+        items.sort(key=lambda it: (it["priority"], it["name"]))
+    if args.limit is not None:
+        items = items[:args.limit]
     if args.json:
         print(json.dumps({"items": items}))
     else:
diff --git a/tests/test_cli.py b/tests/test_cli.py
index 6090d83..ce11022 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -1,8 +1,59 @@
 import json
+import pytest
+
 from tasks_cli.cli import main
 
 
+def _names(capsys, argv):
+    main(argv)
+    out = json.loads(capsys.readouterr().out)
+    return [it["name"] for it in out["items"]]
+
+
 def test_json(capsys):
     main(["--json"])
     out = json.loads(capsys.readouterr().out)
     assert list(out) == ["items"] and len(out["items"]) == 4
+
+
+def test_limit_first_n(capsys):
+    assert _names(capsys, ["--json", "--limit", "2"]) == ["write report", "backup db"]
+
+
+def test_limit_applied_after_sort(capsys):
+    assert _names(capsys, ["--json", "--sort", "name", "--limit", "2"]) == [
+        "archive logs", "backup db",
+    ]
+
+
+def test_limit_all(capsys):
+    assert _names(capsys, ["--json", "--limit", "4"]) == [
+        "write report", "backup db", "call vendor", "archive logs",
+    ]
+
+
+def test_sort_name(capsys):
+    assert _names(capsys, ["--json", "--sort", "name"]) == [
+        "archive logs", "backup db", "call vendor", "write report",
+    ]
+
+
+def test_sort_priority_tie_broken_by_name(capsys):
+    assert _names(capsys, ["--json", "--sort", "priority"]) == [
+        "backup db", "archive logs", "write report", "call vendor",
+    ]
+
+
+def test_sort_without_json(capsys):
+    main(["--sort", "name"])
+    lines = capsys.readouterr().out.splitlines()
+    assert lines == [
+        "2 archive logs", "1 backup db", "3 call vendor", "2 write report",
+    ]
+
+
+@pytest.mark.parametrize("value", ["0", "-3", "abc"])
+def test_limit_rejected(value, capsys):
+    with pytest.raises(SystemExit) as e:
+        main(["--limit", value])
+    assert e.value.code == 2
