+import pytest
 from billing import total
 def test_no_discount():
     assert total([10,20])==30
+def test_discount_percent():
+    assert total([10,20],discount_percent=25)==22.5
+def test_full_discount():
+    assert total([10,20],discount_percent=100)==0
