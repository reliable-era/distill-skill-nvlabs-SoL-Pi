+import pytest
 from billing import total
 def test_no_discount():
     assert total([10,20])==30
+
+def test_percentage_discount():
+    assert total([100,50], discount_percent=20)==120
+
+def test_full_discount():
+    assert total([10,20], discount_percent=100)==0
+
+def test_zero_discount():
+    assert total([10,20], discount_percent=0)==30
+
+def test_discount_above_100_rejected():
+    with pytest.raises(ValueError):
+        total([10], discount_percent=101)
+
+def test_negative_discount_rejected():
+    with pytest.raises(ValueError):
+        total([10], discount_percent=-1)
