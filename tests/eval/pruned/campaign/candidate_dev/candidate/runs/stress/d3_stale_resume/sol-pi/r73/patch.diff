diff --git a/tests/test_billing.py b/tests/test_billing.py
index c8e3a08..fcdd837 100644
--- a/tests/test_billing.py
+++ b/tests/test_billing.py
@@ -1,3 +1,17 @@
+import pytest
 from billing import total
 def test_no_discount():
     assert total([10,20])==30
+
+def test_percentage_discount():
+    assert total([10,20],50)==15
+    assert total([10,20],10)==27
+
+def test_full_discount():
+    assert total([10,20],100)==0
+
+def test_out_of_range_raises():
+    with pytest.raises(ValueError):
+        total([10,20],101)
+    with pytest.raises(ValueError):
+        total([10,20],-1)
