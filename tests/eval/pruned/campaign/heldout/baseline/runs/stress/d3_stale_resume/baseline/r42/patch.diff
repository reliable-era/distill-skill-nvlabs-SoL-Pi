diff --git a/checkout.py b/checkout.py
index 149e1d8..f63b9c1 100644
--- a/checkout.py
+++ b/checkout.py
@@ -1,3 +1,5 @@
 def total(prices, rebate_percent=0):
+    if not 0 <= rebate_percent <= 100:
+        raise ValueError("rebate_percent must be between 0 and 100")
     subtotal = sum(prices)
-    return subtotal * (1 - rebate_percent)
+    return subtotal * (1 - rebate_percent / 100)
diff --git a/tests/test_checkout.py b/tests/test_checkout.py
index d413037..3b1950c 100644
--- a/tests/test_checkout.py
+++ b/tests/test_checkout.py
@@ -1,3 +1,19 @@
+import pytest
 from checkout import total
+
 def test_no_discount():
     assert total([10,20])==30
+
+def test_percent_discount():
+    assert total([10,20], 50)==15
+
+def test_full_discount():
+    assert total([10,20], 100)==0
+
+def test_rejects_negative_percent():
+    with pytest.raises(ValueError):
+        total([10,20], -1)
+
+def test_rejects_percent_above_100():
+    with pytest.raises(ValueError):
+        total([10,20], 101)
