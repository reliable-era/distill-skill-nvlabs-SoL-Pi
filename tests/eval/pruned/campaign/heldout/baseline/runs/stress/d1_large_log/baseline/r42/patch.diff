diff --git a/tests/test_scheduler.py b/tests/test_scheduler.py
index 6d1cd91..958fc85 100644
--- a/tests/test_scheduler.py
+++ b/tests/test_scheduler.py
@@ -1,3 +1,16 @@
 from scheduler import partition_count
 def test_full():
     assert partition_count(list(range(8)),4)==2
+
+def test_partial_tail():
+    # production incident: 17 items at size 5 must yield 4 batches, not 3
+    assert partition_count(list(range(17)),5)==4
+
+def test_empty_input():
+    assert partition_count([],4)==0
+
+def test_exact_multiple():
+    assert partition_count(list(range(10)),5)==2
+
+def test_single_item():
+    assert partition_count([1],4)==1
