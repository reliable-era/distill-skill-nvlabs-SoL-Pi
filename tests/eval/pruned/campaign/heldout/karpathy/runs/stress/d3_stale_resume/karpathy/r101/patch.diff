diff --git a/tests/test_checkout.py b/tests/test_checkout.py
index d413037..37d900a 100644
--- a/tests/test_checkout.py
+++ b/tests/test_checkout.py
@@ -1,3 +1,14 @@
+import pytest
 from checkout import total
 def test_no_discount():
     assert total([10,20])==30
+def test_rebate_percent_applied():
+    assert total([100,50],rebate_percent=10)==135
+def test_full_rebate():
+    assert total([10,20],rebate_percent=100)==0
+def test_rebate_percent_below_zero_rejected():
+    with pytest.raises(ValueError):
+        total([10,20],rebate_percent=-1)
+def test_rebate_percent_above_100_rejected():
+    with pytest.raises(ValueError):
+        total([10,20],rebate_percent=101)
