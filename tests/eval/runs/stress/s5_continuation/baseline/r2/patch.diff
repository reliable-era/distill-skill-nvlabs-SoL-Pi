+def positive_int(value):
+    try:
+        n = int(value)
+    except ValueError:
+        raise argparse.ArgumentTypeError(f"invalid int value: {value!r}")
+    if n <= 0:
+        raise argparse.ArgumentTypeError("must be a positive integer")
+    return n
+
+
 def main(argv=None):
     p = argparse.ArgumentParser(prog="tasks")
     p.add_argument("--json", action="store_true", help="print as JSON")
+    p.add_argument("--limit", type=positive_int,
+                   help="print only the first N items")
+    p.add_argument("--sort", choices=["name", "priority"],
+                   help="sort items by name or by priority (ties by name)")
     args = p.parse_args(argv)
     items = list(ITEMS)
+    if args.sort == "name":
+        items.sort(key=lambda it: it["name"])
+    elif args.sort == "priority":
+        items.sort(key=lambda it: (it["priority"], it["name"]))
+    if args.limit is not None:
+        items = items[:args.limit]
     if args.json:
         print(json.dumps({"items": items}))
     else:
diff --git a/tests/test_cli.py b/tests/test_cli.py
index 6090d83..1142168 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -1,4 +1,5 @@
 import json
+import pytest
 from tasks_cli.cli import main
 
 
@@ -6,3 +7,62 @@ def test_json(capsys):
     main(["--json"])
     out = json.loads(capsys.readouterr().out)
     assert list(out) == ["items"] and len(out["items"]) == 4
+
+
+def test_limit(capsys):
+    main(["--limit", "2"])
+    out = capsys.readouterr().out.strip().splitlines()
+    assert out == ["2 write report", "1 backup db"]
+
+
+def test_limit_zero_rejected():
+    with pytest.raises(SystemExit):
+        main(["--limit", "0"])
+
+
+def test_limit_negative_rejected():
+    with pytest.raises(SystemExit):
+        main(["--limit", "-3"])
+
+
+def test_sort_name(capsys):
+    main(["--sort", "name"])
+    out = capsys.readouterr().out.strip().splitlines()
+    assert out == [
+        "2 archive logs",
+        "1 backup db",
+        "3 call vendor",
+        "2 write report",
+    ]
+
+
+def test_sort_priority_ties_broken_by_name(capsys):
+    main(["--sort", "priority"])
+    out = capsys.readouterr().out.strip().splitlines()
+    assert out == [
+        "1 backup db",
+        "2 archive logs",
+        "2 write report",
+        "3 call vendor",
+    ]
+
+
+def test_limit_after_sort(capsys):
+    main(["--sort", "priority", "--limit", "2"])
+    out = capsys.readouterr().out.strip().splitlines()
+    assert out == ["1 backup db", "2 archive logs"]
+
+
+def test_limit_with_json(capsys):
+    main(["--json", "--limit", "1"])
+    out = json.loads(capsys.readouterr().out)
+    assert list(out) == ["items"] and len(out["items"]) == 1
+    assert out["items"] == [{"name": "write report", "priority": 2}]
+
+
+def test_sort_with_json(capsys):
+    main(["--json", "--sort", "name"])
+    out = json.loads(capsys.readouterr().out)
+    assert [it["name"] for it in out["items"]] == [
+        "archive logs", "backup db", "call vendor", "write report",
+    ]
