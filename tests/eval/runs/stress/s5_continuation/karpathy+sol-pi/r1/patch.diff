 import json
+
+import pytest
+
 from tasks_cli.cli import main
 
 
@@ -6,3 +9,45 @@ def test_json(capsys):
     main(["--json"])
     out = json.loads(capsys.readouterr().out)
     assert list(out) == ["items"] and len(out["items"]) == 4
+
+
+def test_limit(capsys):
+    main(["--limit", "2"])
+    assert capsys.readouterr().out == "2 write report\n1 backup db\n"
+
+
+def test_sort_name(capsys):
+    main(["--sort", "name"])
+    names = [line.split(maxsplit=1)[1] for line in capsys.readouterr().out.splitlines()]
+    assert names == ["archive logs", "backup db", "call vendor", "write report"]
+
+
+def test_sort_priority(capsys):
+    main(["--sort", "priority"])
+    names = [line.split(maxsplit=1)[1] for line in capsys.readouterr().out.splitlines()]
+    assert names == ["backup db", "archive logs", "write report", "call vendor"]
+
+
+def test_limit_after_sort(capsys):
+    main(["--limit", "2", "--sort", "name"])
+    names = [line.split(maxsplit=1)[1] for line in capsys.readouterr().out.splitlines()]
+    assert names == ["archive logs", "backup db"]
+
+
+def test_limit_json(capsys):
+    main(["--json", "--limit", "1"])
+    out = json.loads(capsys.readouterr().out)
+    assert len(out["items"]) == 1 and out["items"][0]["name"] == "write report"
+
+
+def test_sort_limit_json(capsys):
+    main(["--json", "--sort", "priority", "--limit", "2"])
+    out = json.loads(capsys.readouterr().out)
+    assert [it["name"] for it in out["items"]] == ["backup db", "archive logs"]
+
+
+@pytest.mark.parametrize("value", ["0", "-1", "abc"])
+def test_invalid_limit_rejected(value):
+    with pytest.raises(SystemExit) as exc:
+        main(["--limit", value])
+    assert exc.value.code == 2
