@@ -9,11 +9,27 @@ ITEMS = [
 ]
 
 
+def _positive_int(value):
+    n = int(value)
+    if n <= 0:
+        raise argparse.ArgumentTypeError("must be a positive integer")
+    return n
+
+
 def main(argv=None):
     p = argparse.ArgumentParser(prog="tasks")
     p.add_argument("--json", action="store_true", help="print as JSON")
+    p.add_argument("--limit", type=_positive_int, metavar="N",
+                   help="print only the first N items")
+    p.add_argument("--sort", choices=("name", "priority"), help="sort items")
     args = p.parse_args(argv)
     items = list(ITEMS)
+    if args.sort == "name":
+        items.sort(key=lambda it: it["name"])
+    elif args.sort == "priority":
+        items.sort(key=lambda it: (it["priority"], it["name"]))
+    if args.limit is not None:
+        items = items[: args.limit]
     if args.json:
         print(json.dumps({"items": items}))
     else:
diff --git a/tests/test_cli.py b/tests/test_cli.py
index 6090d83..6824e10 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -1,4 +1,7 @@
 import json
+
+import pytest
+
 from tasks_cli.cli import main
 
 
@@ -6,3 +9,55 @@ def test_json(capsys):
     main(["--json"])
     out = json.loads(capsys.readouterr().out)
     assert list(out) == ["items"] and len(out["items"]) == 4
+
+
+def test_limit(capsys):
+    main(["--json", "--limit", "2"])
+    out = json.loads(capsys.readouterr().out)
+    assert [it["name"] for it in out["items"]] == ["write report", "backup db"]
+
+
+def test_limit_larger_than_items(capsys):
+    main(["--json", "--limit", "10"])
+    out = json.loads(capsys.readouterr().out)
+    assert len(out["items"]) == 4
+
+
+def test_limit_zero_rejected(capsys):
+    with pytest.raises(SystemExit) as e:
+        main(["--limit", "0"])
+    assert e.value.code == 2
+    assert "--limit" in capsys.readouterr().err
+
+
+def test_limit_negative_rejected(capsys):
+    with pytest.raises(SystemExit) as e:
+        main(["--limit", "-2"])
+    assert e.value.code == 2
+    assert "--limit" in capsys.readouterr().err
+
+
+def test_sort_name(capsys):
+    main(["--json", "--sort", "name"])
+    out = json.loads(capsys.readouterr().out)
+    assert [it["name"] for it in out["items"]] == [
+        "archive logs", "backup db", "call vendor", "write report"]
+
+
+def test_sort_priority(capsys):
+    main(["--json", "--sort", "priority"])
+    out = json.loads(capsys.readouterr().out)
+    assert [it["name"] for it in out["items"]] == [
+        "backup db", "archive logs", "write report", "call vendor"]
+
+
+def test_sort_then_limit(capsys):
+    main(["--json", "--sort", "name", "--limit", "2"])
+    out = json.loads(capsys.readouterr().out)
+    assert [it["name"] for it in out["items"]] == ["archive logs", "backup db"]
+
+
+def test_text_output_respects_sort_and_limit(capsys):
+    main(["--sort", "priority", "--limit", "2"])
+    assert capsys.readouterr().out.splitlines() == [
+        "1 backup db", "2 archive logs"]
