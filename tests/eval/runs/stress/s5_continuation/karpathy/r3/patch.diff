@@ -1,4 +1,5 @@
 import json
+import pytest
 from tasks_cli.cli import main
 
 
@@ -6,3 +7,43 @@ def test_json(capsys):
     main(["--json"])
     out = json.loads(capsys.readouterr().out)
     assert list(out) == ["items"] and len(out["items"]) == 4
+
+
+def test_sort_name(capsys):
+    main(["--sort", "name"])
+    out = capsys.readouterr().out
+    assert [line.split(" ", 1)[1] for line in out.splitlines()] == [
+        "archive logs",
+        "backup db",
+        "call vendor",
+        "write report",
+    ]
+
+
+def test_sort_priority_tie_broken_by_name(capsys):
+    main(["--sort", "priority"])
+    names = [line.split(" ", 1)[1] for line in capsys.readouterr().out.splitlines()]
+    assert names == [
+        "backup db",
+        "archive logs",
+        "write report",
+        "call vendor",
+    ]
+
+
+def test_limit(capsys):
+    main(["--limit", "2"])
+    assert len(capsys.readouterr().out.splitlines()) == 2
+
+
+def test_limit_after_sort_json(capsys):
+    main(["--sort", "priority", "--limit", "2", "--json"])
+    out = json.loads(capsys.readouterr().out)
+    assert [it["name"] for it in out["items"]] == ["backup db", "archive logs"]
+
+
+@pytest.mark.parametrize("limit", ["0", "-1", "abc"])
+def test_limit_rejects_non_positive(limit):
+    with pytest.raises(SystemExit) as exc:
+        main(["--limit", limit])
+    assert exc.value.code == 2
