+import pytest
 from billing import total
 def test_no_discount():
     assert total([10,20])==30
+
+def test_discount_percentage():
+    assert total([100],25)==75
+    assert total([100,100],50)==100
+
+def test_full_discount():
+    assert total([100],100)==0
+
+def test_discount_below_range():
+    with pytest.raises(ValueError):
+        total([100],-1)
+
+def test_discount_above_range():
+    with pytest.raises(ValueError):
+        total([100],101)
