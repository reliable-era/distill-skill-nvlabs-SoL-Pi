@@ -1,3 +1,16 @@
+import pytest
 from checkout import total
 def test_no_discount():
     assert total([10,20])==30
+def test_rebate_percent():
+    assert total([100], rebate_percent=50)==50
+def test_full_rebate():
+    assert total([10,20], rebate_percent=100)==0
+def test_zero_rebate():
+    assert total([10,20], rebate_percent=0)==30
+def test_rebate_above_100_rejected():
+    with pytest.raises(ValueError):
+        total([10,20], rebate_percent=101)
+def test_negative_rebate_rejected():
+    with pytest.raises(ValueError):
+        total([10,20], rebate_percent=-1)
