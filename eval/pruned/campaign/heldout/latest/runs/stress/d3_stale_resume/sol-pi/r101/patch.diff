@@ -1,3 +1,19 @@
+import pytest
 from checkout import total
+
 def test_no_discount():
     assert total([10,20])==30
+
+def test_rebate_is_a_percentage():
+    assert total([10,20], 50)==15
+    assert total([200], 25)==150
+
+def test_boundaries_zero_and_full():
+    assert total([10,20], 0)==30
+    assert total([10,20], 100)==0
+
+def test_rejects_out_of_range():
+    with pytest.raises(ValueError):
+        total([10,20], 101)
+    with pytest.raises(ValueError):
+        total([10,20], -1)
