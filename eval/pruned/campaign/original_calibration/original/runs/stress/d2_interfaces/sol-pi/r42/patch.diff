diff --git a/tests/test_lookup.py b/tests/test_lookup.py
index b17188e..948f1fc 100644
--- a/tests/test_lookup.py
+++ b/tests/test_lookup.py
@@ -2,3 +2,16 @@ from index import build
 from lookup import get
 def test_simple():
     assert get(build([("ALPHA",7)]),"alpha")==7
+
+def test_whitespace_normalized_both_sides():
+    idx = build([("  ALPHA ", 7)])
+    assert get(idx, "alpha") == 7
+    assert get(idx, "  ALPHA  ") == 7
+    assert get(idx, "AlPhA") == 7
+
+def test_unicode_casefold():
+    # 'ß'.casefold() == 'ss', so STRASSE/straße/strasse all collapse to one key
+    idx = build([("Straße", 7)])
+    assert get(idx, "STRASSE") == 7
+    assert get(idx, "straße") == 7
+    assert get(idx, "strasse") == 7
