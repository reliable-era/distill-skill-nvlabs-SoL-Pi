diff --git a/tasks_cli/cli.py b/tasks_cli/cli.py
index 844f9ff..0212024 100644
--- a/tasks_cli/cli.py
+++ b/tasks_cli/cli.py
@@ -9,11 +9,35 @@ ITEMS = [
 ]
 
 
+SORT_KEYS = {
+    "name": lambda it: it["name"],
+    "priority": lambda it: (it["priority"], it["name"]),
+}
+
+
+def positive_int(value):
+    try:
+        n = int(value)
+    except ValueError:
+        raise argparse.ArgumentTypeError(f"invalid int value: {value!r}")
+    if n <= 0:
+        raise argparse.ArgumentTypeError(f"must be a positive integer, got {n}")
+    return n
+
+
 def main(argv=None):
     p = argparse.ArgumentParser(prog="tasks")
     p.add_argument("--json", action="store_true", help="print as JSON")
+    p.add_argument("--limit", type=positive_int,
+                   help="print only the first N items")
+    p.add_argument("--sort", choices=("name", "priority"),
+                   help="sort items (priority ties broken by name)")
     args = p.parse_args(argv)
     items = list(ITEMS)
+    if args.sort:
+        items = sorted(items, key=SORT_KEYS[args.sort])
+    if args.limit is not None:
+        items = items[:args.limit]
     if args.json:
         print(json.dumps({"items": items}))
     else:
diff --git a/tests/test_cli.py b/tests/test_cli.py
index 6090d83..dd451d1 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -1,4 +1,7 @@
 import json
+
+import pytest
+
 from tasks_cli.cli import main
 
 
@@ -6,3 +9,50 @@ def test_json(capsys):
     main(["--json"])
     out = json.loads(capsys.readouterr().out)
     assert list(out) == ["items"] and len(out["items"]) == 4
+
+
+def test_sort_name(capsys):
+    main(["--sort", "name"])
+    out = capsys.readouterr().out.splitlines()
+    assert out == [
+        "2 archive logs",
+        "1 backup db",
+        "3 call vendor",
+        "2 write report",
+    ]
+
+
+def test_sort_priority_ties_broken_by_name(capsys):
+    main(["--sort", "priority"])
+    out = capsys.readouterr().out.splitlines()
+    assert out == [
+        "1 backup db",
+        "2 archive logs",
+        "2 write report",
+        "3 call vendor",
+    ]
+
+
+def test_limit(capsys):
+    main(["--limit", "2"])
+    out = capsys.readouterr().out.splitlines()
+    assert out == ["2 write report", "1 backup db"]
+
+
+def test_limit_applies_after_sort(capsys):
+    main(["--sort", "priority", "--limit", "2"])
+    out = capsys.readouterr().out.splitlines()
+    assert out == ["1 backup db", "2 archive logs"]
+
+
+def test_json_limit_sort(capsys):
+    main(["--json", "--sort", "name", "--limit", "2"])
+    out = json.loads(capsys.readouterr().out)
+    assert [it["name"] for it in out["items"]] == ["archive logs", "backup db"]
+
+
+@pytest.mark.parametrize("value", ["0", "-1", "abc"])
+def test_limit_rejects_non_positive(value):
+    with pytest.raises(SystemExit) as exc:
+        main(["--limit", value])
+    assert exc.value.code == 2
