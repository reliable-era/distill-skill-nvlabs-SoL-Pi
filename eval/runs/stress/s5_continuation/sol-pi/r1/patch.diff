@@ -1,4 +1,7 @@
 import json
+
+import pytest
+
 from tasks_cli.cli import main
 
 
@@ -6,3 +9,51 @@ def test_json(capsys):
     main(["--json"])
     out = json.loads(capsys.readouterr().out)
     assert list(out) == ["items"] and len(out["items"]) == 4
+
+
+def test_limit_first_n(capsys):
+    main(["--limit", "2"])
+    out = capsys.readouterr().out.splitlines()
+    assert len(out) == 2
+
+
+def test_limit_json(capsys):
+    main(["--json", "--limit", "2"])
+    out = json.loads(capsys.readouterr().out)
+    assert len(out["items"]) == 2
+
+
+@pytest.mark.parametrize("bad", ["0", "-1", "-4", "abc"])
+def test_limit_rejected(bad):
+    with pytest.raises(SystemExit) as e:
+        main(["--limit", bad])
+    assert e.value.code == 2  # argparse error, not a successful run
+
+
+def test_sort_name(capsys):
+    main(["--json", "--sort", "name"])
+    names = [i["name"] for i in json.loads(capsys.readouterr().out)["items"]]
+    assert names == ["archive logs", "backup db", "call vendor", "write report"]
+
+
+def test_sort_priority(capsys):
+    main(["--json", "--sort", "priority"])
+    its = json.loads(capsys.readouterr().out)["items"]
+    assert [(i["priority"], i["name"]) for i in its] == [
+        (1, "backup db"),
+        (2, "archive logs"),
+        (2, "write report"),
+        (3, "call vendor"),
+    ]
+
+
+def test_sort_then_limit(capsys):
+    main(["--json", "--sort", "priority", "--limit", "2"])
+    names = [i["name"] for i in json.loads(capsys.readouterr().out)["items"]]
+    assert names == ["backup db", "archive logs"]
+
+
+def test_sort_invalid_choice():
+    with pytest.raises(SystemExit) as e:
+        main(["--sort", "date"])
+    assert e.value.code == 2
