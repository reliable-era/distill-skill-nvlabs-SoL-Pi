+
+
+def test_limit(capsys):
+    main(["--limit", "2"])
+    assert capsys.readouterr().out == "2 write report\n1 backup db\n"
+
+
+def test_sort_name(capsys):
+    main(["--sort", "name"])
+    assert capsys.readouterr().out == (
+        "2 archive logs\n1 backup db\n3 call vendor\n2 write report\n"
+    )
+
+
+def test_sort_priority(capsys):
+    main(["--sort", "priority"])
+    assert capsys.readouterr().out == (
+        "1 backup db\n2 archive logs\n2 write report\n3 call vendor\n"
+    )
+
+
+def test_limit_after_sort(capsys):
+    main(["--sort", "name", "--limit", "2"])
+    assert capsys.readouterr().out == "2 archive logs\n1 backup db\n"
+
+
+def test_json_sort_limit(capsys):
+    main(["--json", "--sort", "priority", "--limit", "2"])
+    out = json.loads(capsys.readouterr().out)
+    assert out == {
+        "items": [
+            {"name": "backup db", "priority": 1},
+            {"name": "archive logs", "priority": 2},
+        ]
+    }
+
+
+@pytest.mark.parametrize("limit", ["0", "-1"])
+def test_limit_rejects_non_positive(limit):
