 import json
+
+import pytest
+
 from tasks_cli.cli import main
 
 
@@ -6,3 +9,42 @@ def test_json(capsys):
     main(["--json"])
     out = json.loads(capsys.readouterr().out)
     assert list(out) == ["items"] and len(out["items"]) == 4
+
+
+def _names(capsys, argv):
+    main(["--json", *argv])
+    return [it["name"] for it in json.loads(capsys.readouterr().out)["items"]]
+
+
+def test_limit_first_n(capsys):
+    assert _names(capsys, ["--limit", "2"]) == ["write report", "backup db"]
+
+
+def test_limit_applied_after_sort(capsys):
+    assert _names(capsys, ["--sort", "name", "--limit", "1"]) == ["archive logs"]
+
+
+@pytest.mark.parametrize("value", ["0", "-1", "abc"])
+def test_limit_invalid_rejected(capsys, value):
+    with pytest.raises(SystemExit) as exc:
+        main(["--limit", value])
+    assert exc.value.code == 2
+
+
+def test_sort_name(capsys):
+    assert _names(capsys, ["--sort", "name"]) == [
+        "archive logs", "backup db", "call vendor", "write report",
+    ]
+
+
+def test_sort_priority(capsys):
+    assert _names(capsys, ["--sort", "priority"]) == [
+        "backup db", "archive logs", "write report", "call vendor",
+    ]
+
+
+def test_json_schema_preserved_with_options(capsys):
+    main(["--json", "--sort", "priority", "--limit", "2"])
+    out = json.loads(capsys.readouterr().out)
+    assert list(out) == ["items"]
+    assert [it["name"] for it in out["items"]] == ["backup db", "archive logs"]
