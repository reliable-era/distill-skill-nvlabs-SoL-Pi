 import json
+
+import pytest
+
 from tasks_cli.cli import main
 
 
@@ -6,3 +9,43 @@ def test_json(capsys):
     main(["--json"])
     out = json.loads(capsys.readouterr().out)
     assert list(out) == ["items"] and len(out["items"]) == 4
+
+
+def test_sort_name(capsys):
+    main(["--sort", "name", "--json"])
+    out = json.loads(capsys.readouterr().out)
+    assert [it["name"] for it in out["items"]] == [
+        "archive logs",
+        "backup db",
+        "call vendor",
+        "write report",
+    ]
+
+
+def test_sort_priority(capsys):
+    main(["--sort", "priority", "--json"])
+    out = json.loads(capsys.readouterr().out)
+    assert [(it["name"], it["priority"]) for it in out["items"]] == [
+        ("backup db", 1),
+        ("archive logs", 2),
+        ("write report", 2),
+        ("call vendor", 3),
+    ]
+
+
+def test_limit(capsys):
+    main(["--limit", "2", "--json"])
+    out = json.loads(capsys.readouterr().out)
+    assert [it["name"] for it in out["items"]] == ["write report", "backup db"]
+
+
+def test_limit_after_sort(capsys):
+    main(["--sort", "name", "--limit", "2", "--json"])
+    out = json.loads(capsys.readouterr().out)
+    assert [it["name"] for it in out["items"]] == ["archive logs", "backup db"]
+
+
+@pytest.mark.parametrize("bad", ["0", "-1"])
+def test_limit_rejects_non_positive(bad, capsys):
+    with pytest.raises(SystemExit):
+        main(["--limit", bad])
