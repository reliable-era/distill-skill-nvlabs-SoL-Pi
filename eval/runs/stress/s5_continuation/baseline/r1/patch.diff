+def positive_int(value):
+    try:
+        n = int(value)
+    except ValueError:
+        raise argparse.ArgumentTypeError(f"invalid int value: {value!r}")
+    if n <= 0:
+        raise argparse.ArgumentTypeError("must be a positive integer")
+    return n
+
+
 def main(argv=None):
     p = argparse.ArgumentParser(prog="tasks")
     p.add_argument("--json", action="store_true", help="print as JSON")
+    p.add_argument("--limit", type=positive_int, default=None,
+                   metavar="N", help="print only the first N items")
+    p.add_argument("--sort", choices=["name", "priority"], default=None,
+                   help="sort items by name or priority")
     args = p.parse_args(argv)
     items = list(ITEMS)
+    if args.sort == "name":
+        items.sort(key=lambda it: it["name"])
+    elif args.sort == "priority":
+        items.sort(key=lambda it: (it["priority"], it["name"]))
+    if args.limit is not None:
+        items = items[:args.limit]
     if args.json:
         print(json.dumps({"items": items}))
     else:
diff --git a/tests/test_cli.py b/tests/test_cli.py
index 6090d83..1746956 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -1,8 +1,68 @@
 import json
+
+import pytest
+
 from tasks_cli.cli import main
 
 
+def _names(out):
+    return [line.split(" ", 1)[1] for line in out.strip().splitlines()]
+
+
 def test_json(capsys):
     main(["--json"])
     out = json.loads(capsys.readouterr().out)
     assert list(out) == ["items"] and len(out["items"]) == 4
+
+
+def test_default_order_unchanged(capsys):
+    main([])
+    assert _names(capsys.readouterr().out) == [
+        "write report", "backup db", "call vendor", "archive logs",
+    ]
+
+
+def test_limit(capsys):
+    main(["--limit", "2"])
+    assert _names(capsys.readouterr().out) == ["write report", "backup db"]
+
+
+def test_limit_json(capsys):
+    main(["--json", "--limit", "1"])
+    out = json.loads(capsys.readouterr().out)
+    assert out["items"] == [{"name": "write report", "priority": 2}]
+
+
+@pytest.mark.parametrize("arg", ["0", "-1"])
+def test_limit_invalid_rejected(arg, capsys):
+    with pytest.raises(SystemExit) as exc:
+        main(["--limit", arg])
+    assert exc.value.code == 2
+    assert "usage" in capsys.readouterr().err
+
+
+def test_sort_name(capsys):
+    main(["--sort", "name"])
+    assert _names(capsys.readouterr().out) == [
+        "archive logs", "backup db", "call vendor", "write report",
+    ]
+
+
+def test_sort_priority(capsys):
+    main(["--sort", "priority"])
+    assert _names(capsys.readouterr().out) == [
+        "backup db", "archive logs", "write report", "call vendor",
+    ]
+
+
+def test_sort_priority_json(capsys):
+    main(["--json", "--sort", "priority"])
+    out = json.loads(capsys.readouterr().out)
+    assert [it["name"] for it in out["items"]] == [
+        "backup db", "archive logs", "write report", "call vendor",
+    ]
+
+
+def test_sort_then_limit(capsys):
+    main(["--sort", "name", "--limit", "2"])
+    assert _names(capsys.readouterr().out) == ["archive logs", "backup db"]
